# .env.forward.example —— 前向交易（moomoo 纸交易账户）配置模板
#
# 用法：复制为 backend/.env（已在 .gitignore），按注释改，然后
#   python -m app.tasks.forward preflight     # 全部 OK 再继续
#   ..\scripts\start_forward.ps1              # 起 OpenD + 后端（含调度器）
#
# 不含任何密码：登录由 OpenD 自己保管，本系统只连本机 127.0.0.1:11111。

# ── 下单 ────────────────────────────────────────────────────────────────
# moomoo_paper = 每日收盘后把组合目标下成限价单到 **模拟账户**。实盘在代码里被拒，不是配置项。
EXECUTION_MODE=moomoo_paper
MOOMOO_HOST=127.0.0.1
MOOMOO_PORT=11111
MOOMOO_SECURITY_FIRM=FUTUINC
# 0 = 自动选第一个美股模拟账户（预检会回显 acc_id；有多个模拟账户时填死它）
MOOMOO_TRD_ACC_ID=0

# 账户里**划给本系统**的资金（资金切片）。纸账户可以比它大（moomoo 默认 $1,000,000），
# 多出来的钱闲置不动：股数、风控上限、日亏熔断、净值都按这块切片算，切片不加杠杆。
# 只有一条硬约束：不能超过账户实有资金（preflight 会检查）。
PAPER_AUM=10000

# ── 每日自动运行 ────────────────────────────────────────────────────────
# 21:30 UTC 摄取当日数据 → 组合账本 → 下单；22:45 UTC 同一任务补跑一次（数据源延迟兜底）；
# 每晚 23:45 UTC 一致性备份。券商只交易**已批准并激活**的策略配置；没有 active 策略时只对账。
ENABLE_SCHEDULER=true
ENABLE_PAPER_TRADING=true
SCHEDULER_TIMEZONE=UTC

# ── 活数据位置：必须是本地、非云同步盘的**绝对路径** ──────────────────
# 仓库在 OneDrive 里，默认的相对路径会把活库放进 OneDrive → 启动时被拒绝。
# 目录需事先存在（start_forward.ps1 会自动创建 C:\QuantAgentData）。
DATABASE_URL=sqlite:///C:/QuantAgentData/alphas.db
SCHEDULER_DB_URL=sqlite:///C:/QuantAgentData/scheduler_jobs.db
PIT_STORE_DIR=C:/QuantAgentData/pit_store
# 备份是静态快照，放云盘才安全（等于异地副本）；默认 backups/（相对启动目录）
# BACKUP_DIR=D:/OneDrive/QuantAgentBackups

# ── 交易宇宙与价格源（路线图 TR.2 的决策，不是代码默认值）────────────────
# us_broad_large：~95 只、11 板块流动大盘，≤100 只正好放进 moomoo 免费账户的月度历史K线额度。
PAPER_DATASET=us_broad_large
# 首次运行从这一天回填历史（之后每天只追加新 bar；回填部分计为回放，不算前向证据）
PAPER_START=2020-01-01
# moomoo = 单一权威源：研究数据与执行券商同源，消除 train/serve skew（TR.2）。
# 改成 yahoo 预检会给 WARN（不同源）。
PRICE_SOURCE=moomoo

# ── 基本面数据（Phase 10，默认关）──────────────────────────────────────
# 开启后美股数据集多出 earnings_yield / book_to_price / roe / gross_margin / asset_growth /
# sue / days_since_earnings，来源 SEC EDGAR，按**实际披露日**对齐（披露后第一个交易日起可见）。
# SEC 要求每个请求声明身份（名字 + 联系邮箱），没有默认值，系统不会替你编。
# 事实存到 <PIT_STORE_DIR>/fundamentals。只用价格的策略不需要开。
# ENABLE_FUNDAMENTALS=true
# EDGAR_USER_AGENT=Your Name you@example.com

# ── 风控（默认值即可；改之前读 app/config.py 的注释）──────────────────
# EXEC_LIMIT_BAND_BPS=50
# EXEC_MAX_DAILY_LOSS=0.05
# EXEC_MAX_PRICE_DEVIATION=0.15
# RISK_MAX_NAME_WEIGHT=0.10
