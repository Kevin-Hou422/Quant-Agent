venv/
.env

# Python caches
__pycache__/
*.pyc
*.pyo

# Databases & scheduler jobstore (Task 6.2 — never commit; avoids stash/merge
# binary conflicts and OneDrive sync corruption)
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
scheduler_jobs.db

# Data caches
*.parquet
**/feature_store/**/*.parquet
# Point-in-Time store (Task 8.1 — proprietary vintage data, never commit)
pit_store/
backend/pit_store/

# Node
node_modules/

# Test / build artifacts
.pytest_cache/
_*.log
htmlcov/
.coverage
dist/
build/

# 变异测试的原地备份（绝不能进仓库）
*.mutbak

# 变异测试的中间态：可续跑的进度文件与按需生成的计划。
# 结论落在 backend/tests/meta/measured_modules.json（那份要提交），
# 计划用 backend/tools/mutation/make_plan.py 重新生成。
backend/tools/mutation/progress*.json
backend/tools/mutation/plan_*.json
